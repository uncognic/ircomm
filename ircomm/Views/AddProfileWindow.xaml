<Window x:Class="ircomm.AddProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Profile" Width="420" Height="400
        
        " WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock Text="Add Profile" FontWeight="Bold" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Name:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="NameTextBox" Width="280"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Username:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="UsernameTextBox" Width="280"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Password:" Width="80" VerticalAlignment="Center"/>
                <PasswordBox x:Name="PasswordBox" Width="280"/>
            </StackPanel>
            <TextBlock Margin="80,4,0,0"
                Text="Warning: Password is stored in plaintext in profiles.json"
                FontSize="11"
                FontStyle="Italic"/>
        </StackPanel>
        

        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Server:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="ServerTextBox" Width="280"/>
        </StackPanel>
        

        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Port:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="PortTextBox" Width="100" Text="6667"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <CheckBox x:Name="UseSslCheckBox" Content="Use TLS/SSL" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <CheckBox x:Name="IsBouncerCheckBox" Content="Use bouncer / require PASS" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Bouncer network:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="BouncerNetworkTextBox" Width="280"/>
        </StackPanel>

        
        
        

        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Bouncer user:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="BouncerUsernameTextBox" Width="280"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Bouncer pass:" Width="80" VerticalAlignment="Center"/>
                <PasswordBox x:Name="BouncerPasswordBox" Width="280"/>
            </StackPanel>
            <TextBlock Margin="80,4,0,0"
                       Text="Warning: Bouncer password is stored in plaintext in profiles.json"
                       FontSize="11"
                       FontStyle="Italic"/>
        </StackPanel>

       
        

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="OK" Width="90" IsDefault="True" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="8,0,0,0" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>